rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'super_admin' || getUserData().role == 'admin');
    }

    function isEditor() {
      return isAuthenticated() && 
        (getUserData().role == 'editor' || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'published' && resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /productVariants/{variantId} {
      allow read: if resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /productPackagingOptions/{optionId} {
      allow read: if resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /productCategories/{categoryId} {
      allow read: if resource.data.status == 'published' && resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /productBrands/{brandId} {
      allow read: if resource.data.status == 'published' && resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /services/{serviceId} {
      allow read: if resource.data.status == 'published' && resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /serviceProcesses/{processId} {
      allow read: if resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /serviceBenefits/{benefitId} {
      allow read: if resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /faqs/{faqId} {
      allow read: if resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /teamMembers/{memberId} {
      allow read: if resource.data.isEnabled == true;
      allow write: if isEditor();
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published';
      allow write: if isEditor();
    }

    match /legalPages/{pageId} {
      allow read: if resource.data.status == 'published';
      allow write: if isEditor();
    }

    match /quoteRequests/{quoteId} {
      allow create: if true; 
      allow read, update: if isAdmin(); 
      allow delete: if isAuthenticated() && getUserData().role == 'super_admin'; 
    }

    match /contactMessages/{messageId} {
      allow create: if true; 
      allow read, update: if isAdmin();
      allow delete: if isAuthenticated() && getUserData().role == 'super_admin';
    }

    // নতুন যুক্ত করা হয়েছে: Site Settings Rules
    match /siteSettings/{settingId} {
      allow read: if true; // ওয়েবসাইট ভিজিটরদের লোগো বা ইনফো দেখানোর জন্য পাবলিক করা হয়েছে
      allow write: if isAdmin(); // শুধুমাত্র অ্যাডমিন সেটিংস পরিবর্তন করতে পারবে
    }

    match /changeHistory/{historyId} {
      allow read: if isAdmin();
      allow write, delete: if isAuthenticated() && getUserData().role == 'super_admin';
    }
  }
}